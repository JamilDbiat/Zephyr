<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>JEEP® | Build Your Jeep</title>
  <link rel="stylesheet" href="StyleSheet1.css"/>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <style>
    /* ── Model cards ── */
    .model-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin-top: 12px;
    }
    .model-card {
      background: var(--surface2);
      border: 2px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 10px;
      text-align: center;
      cursor: pointer;
      transition: border-color .2s, transform .2s, box-shadow .2s;
    }
    .model-card:hover {
      border-color: rgba(93,252,110,0.4);
      transform: translateY(-3px);
    }
    .model-card.selected {
      border-color: var(--green);
      box-shadow: 0 0 18px var(--green-glow);
      background: var(--green-dim);
    }
    .model-card .model-emoji { font-size: 2rem; display: block; margin-bottom: 8px; }
    .model-card .model-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: .5px;
    }
    .model-card .model-price {
      font-size: 12px;
      color: var(--muted);
      margin-top: 4px;
    }

    /* ── Color swatches ── */
    .color-grid {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 12px;
    }
    .swatch {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 3px solid transparent;
      cursor: pointer;
      transition: transform .2s, border-color .2s;
      position: relative;
    }
    .swatch:hover { transform: scale(1.15); }
    .swatch.selected {
      border-color: var(--green);
      transform: scale(1.2);
    }
    .swatch[title="White"] { border-color: #444; }
    .swatch[title="White"].selected { border-color: var(--green); }

    /* ── Engine options ── */
    .engine-options {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 12px;
    }
    .engine-option {
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--surface2);
      border: 2px solid var(--border);
      border-radius: var(--radius);
      padding: 12px 16px;
      cursor: pointer;
      transition: border-color .2s, background .2s;
    }
    .engine-option:hover { border-color: rgba(93,252,110,0.4); }
    .engine-option.selected {
      border-color: var(--green);
      background: var(--green-dim);
    }
    .engine-option input[type="radio"] { accent-color: var(--green); width: 16px; height: 16px; }
    .engine-label { flex: 1; }
    .engine-label strong { font-size: 14px; font-weight: 600; display: block; }
    .engine-label span { font-size: 12px; color: var(--muted); }
    .engine-add { color: var(--green); font-size: 13px; font-weight: 700; }

    /* ── Accessories ── */
    .acc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
      margin-top: 12px;
    }
    .acc-item {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface2);
      border: 2px solid var(--border);
      border-radius: var(--radius);
      padding: 11px 14px;
      cursor: pointer;
      transition: border-color .2s, background .2s;
    }
    .acc-item:hover { border-color: rgba(93,252,110,0.4); }
    .acc-item.selected { border-color: var(--green); background: var(--green-dim); }
    .acc-item input[type="checkbox"] { accent-color: var(--green); width: 16px; height: 16px; }
    .acc-name { flex: 1; font-size: 13px; font-weight: 500; }
    .acc-price { font-size: 12px; color: var(--green); font-weight: 700; }

    /* ── Summary card ── */
    .summary-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      position: sticky;
      top: 80px;
    }
    .summary-card h3 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 22px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 20px;
      color: var(--green);
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 9px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .summary-row:last-of-type { border-bottom: none; }
    .summary-row .label { color: var(--muted); }
    .summary-row .value { font-weight: 600; }
    .total-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 2px solid var(--green);
    }
    .total-row .total-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 18px;
      font-weight: 800;
      text-transform: uppercase;
    }
    .total-row .total-price {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 28px;
      font-weight: 900;
      color: var(--green);
    }
    .btn-group { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; }

    /* ── Storage status ── */
    .storage-status {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      font-size: 13px;
      margin-top: 14px;
    }
    .storage-status .status-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .storage-status .status-row:last-child { margin-bottom: 0; }
    .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .dot.green { background: var(--green); }
    .dot.grey  { background: var(--muted); }

    /* ── Section label ── */
    .config-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 16px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--green);
      margin-bottom: 4px;
    }

    /* ── Session tracker ── */
    .session-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px 24px;
      margin-top: 32px;
    }
    .session-box h3 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 18px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 12px;
    }
    .session-tags { display: flex; gap: 8px; flex-wrap: wrap; }
    .session-tag {
      background: var(--surface2);
      border: 1px solid var(--border);
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      font-family: 'Barlow Condensed', sans-serif;
      letter-spacing: .5px;
      text-transform: uppercase;
    }
    .session-note { font-size: 12px; color: var(--muted); margin-top: 10px; }

    /* ── Saved toast ── */
    .toast {
      position: fixed;
      bottom: 32px;
      right: 32px;
      background: var(--green);
      color: #000;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 800;
      font-size: 15px;
      letter-spacing: .5px;
      padding: 12px 22px;
      border-radius: 999px;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity .3s, transform .3s;
      pointer-events: none;
      z-index: 9999;
    }
    .toast.show { opacity: 1; transform: translateY(0); }
  </style>
</head>
