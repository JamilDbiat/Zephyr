using System;
using System.Data.SqlClient;
using System.Configuration;
using System.Web;

namespace JeepSite
{
    public class SaveUser : IHttpHandler
    {
        public void ProcessRequest(HttpContext context)
        {
            // Allow AJAX calls from the same site
            context.Response.ContentType = "application/json";
            context.Response.AddHeader("Access-Control-Allow-Origin", "*");

            try
            {
                // Read form values sent by SignUp.html
                string name       = context.Request.Form["name"]       ?? "";
                string email      = context.Request.Form["email"]      ?? "";
                string password   = context.Request.Form["password"]   ?? "";
                string birthDate  = context.Request.Form["birthDate"]  ?? "";
                string favColor   = context.Request.Form["favColor"]   ?? "";
                string model      = context.Request.Form["model"]      ?? "";
                string driveType  = context.Request.Form["driveType"]  ?? "";
                int    experience = int.TryParse(context.Request.Form["experience"], out int exp) ? exp : 5;

                // Get connection string from Web.config
                string connStr = ConfigurationManager.ConnectionStrings["JeepSiteDB"].ConnectionString;

                using (SqlConnection conn = new SqlConnection(connStr))
                {
                    conn.Open();

                    string sql = @"
                        INSERT INTO Users
                            (FullName, Email, Password, BirthDate, FavouriteColor, PreferredModel, DrivingType, ExperienceLevel)
                        VALUES
                            (@name, @email, @password, @birthDate, @favColor, @model, @driveType, @experience)";

                    using (SqlCommand cmd = new SqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@name",       name);
                        cmd.Parameters.AddWithValue("@email",      email);
                        cmd.Parameters.AddWithValue("@password",   password);
                        cmd.Parameters.AddWithValue("@birthDate",  string.IsNullOrEmpty(birthDate)
                                                                    ? (object)DBNull.Value
                                                                    : DateTime.Parse(birthDate));
                        cmd.Parameters.AddWithValue("@favColor",   favColor);
                        cmd.Parameters.AddWithValue("@model",      model);
                        cmd.Parameters.AddWithValue("@driveType",  driveType);
                        cmd.Parameters.AddWithValue("@experience", experience);

                        cmd.ExecuteNonQuery();
                    }
                }

                // Success response
                context.Response.Write("{\"ok\":true,\"message\":\"User saved successfully\"}");
            }
            catch (Exception ex)
            {
                // Send error back to the browser (safe for dev; remove ex.Message in production)
                string safeMsg = ex.Message.Replace("\"", "'").Replace("\r", "").Replace("\n", " ");
                context.Response.Write("{\"ok\":false,\"error\":\"" + safeMsg + "\"}");
            }
        }

        public bool IsReusable => false;
    }
}

