<script>
/* ============================================================
   JEEP OOP DEMO
   Parent: Vehicle (5 props, 2 methods)
   Children: Wrangler, GrandCherokee, Compass
     — each adds 2 props + 2 unique methods
   2 objects per class → printed into formatted tables
   ============================================================ */

/* ---- Parent Class ---- */
class Vehicle {
  constructor(make, model, year, color, price) {
    this.make  = make;
    this.model = model;
    this.year  = year;
    this.color = color;
    this.price = price;
  }

  // method 1 — shared
  describe() {
    return `${this.year} ${this.make} ${this.model} (${this.color})`;
  }

  // method 2 — shared
  isAffordable(budget) {
    return this.price <= budget;
  }
}

/* ---- Child 1: Wrangler ---- */
class Wrangler extends Vehicle {
  constructor(make, model, year, color, price, fourWDType, offRoadRating) {
    super(make, model, year, color, price);
    this.fourWDType     = fourWDType;     // extra prop 1
    this.offRoadRating  = offRoadRating;  // extra prop 2
  }

  // unique method 1
  getTerrainMode() {
    return this.offRoadRating >= 8
      ? "⛰ Rock-Crawl Mode"
      : "🌲 Trail Mode";
  }

  // unique method 2
  upgradeRating(n) {
    this.offRoadRating = Math.min(10, this.offRoadRating + n);
    return `Rating upgraded to ${this.offRoadRating}/10`;
  }
}

/* ---- Child 2: GrandCherokee ---- */
class GrandCherokee extends Vehicle {
  constructor(make, model, year, color, price, luxuryLevel, seats) {
    super(make, model, year, color, price);
    this.luxuryLevel = luxuryLevel;  // extra prop 1
    this.seats       = seats;        // extra prop 2
  }

  // unique method 1
  getLuxuryLabel() {
    if (this.luxuryLevel >= 9) return "👑 Platinum";
    if (this.luxuryLevel >= 7) return "⭐ Premium";
    return "🔹 Standard";
  }

  // unique method 2
  addPassenger() {
    if (!this.occupied) this.occupied = 1;
    else this.occupied = Math.min(this.seats, this.occupied + 1);
    return `Occupied: ${this.occupied}/${this.seats} seats`;
  }
}

/* ---- Child 3: Compass ---- */
class Compass extends Vehicle {
  constructor(make, model, year, color, price, fuelType, rangeMiles) {
    super(make, model, year, color, price);
    this.fuelType   = fuelType;    // extra prop 1
    this.rangeMiles = rangeMiles;  // extra prop 2
  }

  // unique method 1
  getEfficiencyLabel() {
    if (this.rangeMiles > 400) return "🌿 Eco Champion";
    if (this.rangeMiles > 280) return "✅ Efficient";
    return "⚡ City Runner";
  }

  // unique method 2
  refuel(miles) {
    this.rangeMiles += miles;
    return `Range extended to ${this.rangeMiles} mi`;
  }
}

/* ============================================================
   Instantiate 2 objects per class
   ============================================================ */
const wrangler1 = new Wrangler("Jeep","Wrangler",2024,"Granite Crystal","$34,000","Part-time 4WD", 8);
const wrangler2 = new Wrangler("Jeep","Wrangler Rubicon",2025,"Firecracker Red","$49,000","Full-time 4WD", 10);

const cherokee1 = new GrandCherokee("Jeep","Grand Cherokee",2024,"Diamond Black","$40,000", 8, 7);
const cherokee2 = new GrandCherokee("Jeep","Grand Cherokee L",2025,"Baltic Grey","$55,000", 9, 8);

const compass1  = new Compass("Jeep","Compass",2024,"Sting-Gray","$28,500","Gasoline", 310);
const compass2  = new Compass("Jeep","Compass 4xe",2025,"Bright White","$36,000","Plug-in Hybrid", 460);

/* ============================================================
   Render helpers
   ============================================================ */
function cell(v) { return `<td>${v}</td>`; }
function bool(v) { return v ? '<span style="color:var(--green)">✔ Yes</span>' : '<span style="color:var(--red)">✘ No</span>'; }

/* ---- Wrangler table ---- */
function renderWrangler(obj, name) {
  return `<tr>
    ${cell(`<strong>${name}</strong>`)}
    ${cell(obj.make)}${cell(obj.model)}${cell(obj.year)}${cell(obj.color)}${cell(obj.price)}
    ${cell(obj.fourWDType)}${cell(obj.offRoadRating+"/10")}
    ${cell(obj.describe())}
    ${cell(bool(obj.isAffordable(50000)))}
    ${cell(obj.getTerrainMode())}
    ${cell(obj.upgradeRating(1))}
  </tr>`;
}

document.getElementById("wranglerRows").innerHTML =
  renderWrangler(wrangler1, "wrangler1") +
  renderWrangler(wrangler2, "wrangler2");

/* ---- Cherokee table ---- */
function renderCherokee(obj, name) {
  return `<tr>
    ${cell(`<strong>${name}</strong>`)}
    ${cell(obj.make)}${cell(obj.model)}${cell(obj.year)}${cell(obj.color)}${cell(obj.price)}
    ${cell(obj.luxuryLevel+"/10")}${cell(obj.seats)}
    ${cell(obj.describe())}
    ${cell(bool(obj.isAffordable(60000)))}
    ${cell(obj.getLuxuryLabel())}
    ${cell(obj.addPassenger())}
  </tr>`;
}

document.getElementById("cherokeeRows").innerHTML =
  renderCherokee(cherokee1, "cherokee1") +
  renderCherokee(cherokee2, "cherokee2");

/* ---- Compass table ---- */
function renderCompass(obj, name) {
  return `<tr>
    ${cell(`<strong>${name}</strong>`)}
    ${cell(obj.make)}${cell(obj.model)}${cell(obj.year)}${cell(obj.color)}${cell(obj.price)}
    ${cell(obj.fuelType)}${cell(obj.rangeMiles+" mi")}
    ${cell(obj.describe())}
    ${cell(bool(obj.isAffordable(35000)))}
    ${cell(obj.getEfficiencyLabel())}
    ${cell(obj.refuel(50))}
  </tr>`;
}

document.getElementById("compassRows").innerHTML =
  renderCompass(compass1, "compass1") +
  renderCompass(compass2, "compass2");
</script>

<script src="JavaScript.js"></script>
</body>
