  align-items: center;
}

.nav-links a {
  text-decoration: none;
  color: var(--muted);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: .4px;
  padding: 7px 12px;
  border-radius: 8px;
  transition: color .2s, background .2s;
}
.nav-links a:hover  { color: var(--text); background: rgba(255,255,255,0.06); }
.nav-links a.active { color: var(--green); background: var(--green-dim); }

/* dropdown */
.dropdown { position: relative; }

.dropdown-menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 0;
  min-width: 200px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 6px;
  display: none;
  box-shadow: 0 24px 60px rgba(0,0,0,.6);
  z-index: 200;
}
.dropdown-menu li { list-style: none; }
.dropdown-menu a { display: block; padding: 9px 12px; border-radius: 8px; color: var(--muted) !important; font-size: 13px; }
.dropdown-menu a:hover { color: var(--green) !important; background: var(--green-dim) !important; }
.dropdown:hover .dropdown-menu { display: block; }

/* hamburger */
.nav-btn {
  display: none;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
  color: #fff;
  border-radius: 10px;
  padding: 8px 11px;
  cursor: pointer;
  font-size: 18px;
  transition: background .2s;
}
.nav-btn:hover { background: rgba(255,255,255,0.1); }

/* spinning logo badge */
.nav-logo-wrap {
  position: absolute;
  top: calc(var(--nav-h) + 8px);
  right: 22px;
  z-index: 998;
}
.jeep-logo-spin {
  width: 52px;
  height: auto;
  animation: jeepSpin 4s linear infinite;
  opacity: .7;
  filter: drop-shadow(0 0 6px var(--green-glow));
}

/* ============================================================
   HERO
   ============================================================ */
.hero {
  position: relative;
  height: 100vh;
  min-height: 600px;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(0,0,0,.75) 0%, rgba(0,0,0,.4) 100%);
  z-index: 1;
}

.hero-inner {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 28px;
}

.hero h1 {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: clamp(48px, 7vw, 88px);
  font-weight: 900;
  letter-spacing: -1px;
  line-height: 1;
  margin-bottom: 16px;
  text-transform: uppercase;
}

.hero h1 span { color: var(--green); }

.hero p {
  color: rgba(255,255,255,0.65);
  font-size: 16px;
  max-width: 540px;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  gap: 12px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.scroll-hint {
  margin-top: 48px;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.2);
  font-size: 18px;
  animation: bounce 1.8s infinite;
}

/* ============================================================
   PAGE HERO (inner pages)
   ============================================================ */
.page-hero {
  padding: 56px 28px 28px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, rgba(93,252,110,0.04) 0%, transparent 100%);
}

.page-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 900;
  letter-spacing: -1px;
  text-transform: uppercase;
}

.page-subtitle {
  color: var(--muted);
  margin-top: 6px;
  font-size: 15px;
}

/* ============================================================
   LAYOUT HELPERS
   ============================================================ */
.section  { padding: 70px 28px; }

.wrap     { max-width: 1100px; margin: 0 auto; }

.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  align-items: start;
}

.panel { display: flex; flex-direction: column; gap: 16px; }

.row   { display: flex; align-items: center; }
.gap   { gap: 10px; }
.mt    { margin-top: 12px; }

/* ============================================================
   TYPOGRAPHY
   ============================================================ */
.section-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 36px;
  font-weight: 800;
  letter-spacing: -0.5px;
  text-align: center;
  margin-bottom: 20px;
  text-transform: uppercase;
}
.section-title.left { text-align: left; }

.muted { color: var(--muted); }
.small { font-size: 13px; }

.link { color: var(--green); text-decoration: none; }
.link:hover { text-decoration: underline; }

/* ============================================================
   BUTTONS
   ============================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--green);
  color: #000;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-decoration: none;
  padding: 12px 22px;
  border-radius: 999px;
  border: none;
  cursor: pointer;
  transition: transform .2s, filter .2s, box-shadow .2s;
}
.btn:hover {
  transform: translateY(-2px);
  filter: brightness(1.08);
  box-shadow: 0 8px 28px var(--green-glow);
}
.btn:active { transform: translateY(0); }

.btn-ghost {
  background: transparent;
  color: #fff;
  border: 1px solid rgba(255,255,255,0.18);
}
.btn-ghost:hover {
  background: rgba(255,255,255,0.06);
  box-shadow: none;
  filter: none;
}

/* ============================================================
   CARDS
   ============================================================ */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
  margin-top: 20px;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 22px;
  transition: transform .25s, box-shadow .25s, border-color .25s;
}
.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 50px rgba(0,0,0,.4);
  border-color: var(--green-glow);
}
.card h3 {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: .5px;
  margin-bottom: 8px;
  text-transform: uppercase;
}
.card p { color: var(--muted); font-size: 14px; line-height: 1.65; margin-bottom: 14px; }

.feature-list {
  padding-left: 20px;
  color: var(--muted);
  line-height: 2;
  margin-top: 8px;
}

/* ============================================================
   TABLE
   ============================================================ */
.table-actions {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-bottom: 14px;
  flex-wrap: wrap;
}

.table-box {
  overflow-x: auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
}

.table {
  width: 100%;
  border-collapse: collapse;
  min-width: 600px;
  font-size: 14px;
}
.table th, .table td {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  text-align: left;
}
.table th {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--green);
  background: rgba(0,0,0,.3);
}
.table tbody tr:last-child td { border-bottom: none; }
.table tbody tr { transition: background .15s; }
.table tbody tr:hover   { background: var(--green-dim); cursor: pointer; }
.table tbody tr.selected{ background: rgba(93,252,110,0.16); }

/* ============================================================
   FORMS
   ============================================================ */
.form-wrap { max-width: 560px; }

.form {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.form-row label { font-size: 13px; font-weight: 600; color: var(--muted); letter-spacing: .3px; }
.form-row.two { flex-direction: row; gap: 14px; }
.form-row.two > div { flex: 1; display: flex; flex-direction: column; gap: 6px; }

.input {
  width: 100%;
  padding: 11px 14px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.04);
  color: var(--text);
  font-family: 'Barlow', sans-serif;
  font-size: 14px;
  outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.input:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(93,252,110,0.12);
}
.input::placeholder { color: var(--muted); }

select.input {
  background: var(--surface2);
  cursor: pointer;
}
select.input option { background: #111; color: #fff; }

textarea.input { resize: vertical; min-height: 100px; }

.inline { display: flex; gap: 8px; flex-wrap: wrap; }

.chip {
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 13px;
  cursor: pointer;
  transition: background .2s, border-color .2s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.chip:hover { background: var(--green-dim); border-color: var(--green); }

.error   { color: var(--red); font-size: 12px; min-height: 16px; }
.success { color: var(--green); font-weight: 600; font-size: 14px; margin-top: 4px; }

.form-alert {
  display: none;
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
}
.form-alert.error   { display: block; background: rgba(255,91,91,0.1); color: #ff8080; border: 1px solid rgba(255,91,91,0.3); }
.form-alert.success { display: block; background: rgba(93,252,110,0.1); color: var(--green); border: 1px solid rgba(93,252,110,0.3); }

.help-box {
  display: none;
  margin-top: 10px;
  padding: 14px;
  border-radius: var(--radius);
  background: var(--surface2);
  border: 1px solid var(--border);
  font-size: 13px;
  color: var(--muted);
}

/* ============================================================
   MODEL DISPLAY
   ============================================================ */
.model-display {
  display: flex;
  gap: 18px;
  align-items: center;
  padding: 16px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  margin-top: 20px;
}
.model-display img {
  width: 220px;
  height: 130px;
  object-fit: cover;
  border-radius: var(--radius);
  background: #0a0a0a;
  flex-shrink: 0;
}
.model-info h2 {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 28px;
  font-weight: 800;
  text-transform: uppercase;
}
.model-info p { color: var(--muted); font-size: 13px; margin-top: 6px; }

/* ============================================================
   MEDIA — video + canvas
   ============================================================ */
.video {
  width: 100%;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  background: var(--surface2);
}

.canvas {
  width: 100%;
  max-width: 420px;
  height: auto;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.03);
  display: block;
}

/* ============================================================
   MAP
   ============================================================ */
.iframe-box {
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--border);
}
.iframe-box iframe {
  width: 100%;
  height: 320px;
  border: none;
  display: block;
  filter: invert(1) hue-rotate(180deg) brightness(0.85);
}

/* ============================================================
   FOOTER
   ============================================================ */
.footer {
  padding: 28px;
  border-top: 1px solid var(--border);
  margin-top: 20px;
}
.footer-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  color: var(--muted);
  font-size: 13px;
}

/* ============================================================
   OOP PAGE — specific
   ============================================================ */
.oop-intro {
  max-width: 720px;
  color: var(--muted);
  line-height: 1.8;
  font-size: 15px;
}

.oop-class-block {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  margin-top: 28px;
}
.oop-class-block h3 {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 22px;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--green);
  margin-bottom: 6px;
  letter-spacing: 1px;
}
.oop-class-block .class-meta {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 16px;
  letter-spacing: .4px;
}

.obj-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}
.obj-card {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px;
}
.obj-card .obj-name {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--text);
  text-transform: uppercase;
  letter-spacing: .5px;
}
.obj-card .obj-prop {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.9;
}
.obj-card .obj-prop span { color: var(--text); font-weight: 500; }

.fn-list {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}
.fn-tag {
  background: var(--green-dim);
  color: var(--green);
  border: 1px solid rgba(93,252,110,0.2);
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  font-family: monospace;
  letter-spacing: .3px;
}

/* ============================================================
   ANIMATIONS
   ============================================================ */
.fade-in { animation: fadeIn .8s ease both; }
.delay-1 { animation-delay: .18s; }
.delay-2 { animation-delay: .36s; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0);    }
}

@keyframes bounce {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-8px); }
}

@keyframes jeepSpin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@keyframes pulse {
  0%,100% { opacity: .7; }
  50%      { opacity: 1; }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 860px) {
  .nav-btn { display: block; }

  .nav-links {
    display: none;
    position: absolute;
    right: 16px;
    top: calc(var(--nav-h) + 4px);
    flex-direction: column;
    background: rgba(10,10,10,0.96);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 10px;
    width: 240px;
    backdrop-filter: blur(16px);
  }
  .nav-links.open { display: flex; }

  .dropdown-menu { position: static; box-shadow: none; }
  .dropdown:hover .dropdown-menu { display: none; }

  .split { grid-template-columns: 1fr; }

  .model-display { flex-direction: column; align-items: flex-start; }
  .model-display img { width: 100%; height: 180px; }
}

