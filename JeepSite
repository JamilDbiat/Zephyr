<script>
/* ============================================================
   BUILD YOUR JEEP — Web Storage Demo
   localStorage  → saves build permanently across sessions
   sessionStorage → tracks models viewed in current tab session
   ============================================================ */

// ── State ──────────────────────────────────────────────────
const state = {
  model:    null,
  basePrice: 0,
  color:    "Granite Black",
  colorAdd: 0,
  engine:   "2.0L Turbo 4-Cyl",
  engineAdd: 0,
  accessories: []
};

// ── Helpers ────────────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(() => t.classList.remove("show"), 2500);
}

function fmt(n) {
  return "$" + n.toLocaleString();
}

// ── Update summary card ────────────────────────────────────
function updateSummary() {
  document.getElementById("sumModel").textContent  = state.model  || "—";
  document.getElementById("sumColor").textContent  = state.color;
  document.getElementById("sumEngine").textContent = state.engine;
  document.getElementById("sumAcc").textContent    = state.accessories.length
    ? state.accessories.join(", ")
    : "None";

  if (state.model) {
    const accTotal = state.accessories.reduce((sum, name) => {
      const el = document.querySelector(`[data-acc="${name}"]`);
      return sum + (el ? parseInt(el.dataset.add) : 0);
    }, 0);
    const total = state.basePrice + state.colorAdd + state.engineAdd + accTotal;
    document.getElementById("sumTotal").textContent = fmt(total);
  } else {
    document.getElementById("sumTotal").textContent = "$—";
  }
}

// ── Update localStorage status indicator ───────────────────
function updateStorageStatus() {
  const saved = localStorage.getItem("jeepBuild");
  const dot    = document.getElementById("localDot");
  const status = document.getElementById("localStatus");
  if (saved) {
    const b = JSON.parse(saved);
    dot.className    = "dot green";
    status.textContent = `localStorage: "${b.model}" build saved`;
  } else {
    dot.className    = "dot grey";
    status.textContent = "No build saved in localStorage";
  }
}

// ── Update sessionStorage tracker ─────────────────────────
function updateSessionTracker() {
  const raw     = sessionStorage.getItem("viewedModels");
  const viewed  = raw ? JSON.parse(raw) : [];
  const dot     = document.getElementById("sessionDot");
  const status  = document.getElementById("sessionStatus");
  const tagsEl  = document.getElementById("sessionTags");

  dot.className    = "dot green";
  status.textContent = `sessionStorage: ${viewed.length} model(s) viewed`;

  if (viewed.length === 0) {
    tagsEl.innerHTML = '<span style="color:var(--muted);font-size:13px">No models selected yet.</span>';
  } else {
    tagsEl.innerHTML = viewed
      .map(m => `<span class="session-tag">${m}</span>`)
      .join("");
  }
}

function trackModelInSession(model) {
  const raw    = sessionStorage.getItem("viewedModels");
  const viewed = raw ? JSON.parse(raw) : [];
  if (!viewed.includes(model)) {
    viewed.push(model);
    sessionStorage.setItem("viewedModels", JSON.stringify(viewed));
  }
  updateSessionTracker();
}

// ── Model cards ────────────────────────────────────────────
document.querySelectorAll(".model-card").forEach(card => {
  card.addEventListener("click", () => {
    document.querySelectorAll(".model-card").forEach(c => c.classList.remove("selected"));
    card.classList.add("selected");
    state.model     = card.dataset.model;
    state.basePrice = parseInt(card.dataset.base);
    trackModelInSession(state.model);   // sessionStorage
    updateSummary();
  });
});

// ── Color swatches ─────────────────────────────────────────
document.querySelectorAll(".swatch").forEach(sw => {
  sw.addEventListener("click", () => {
    document.querySelectorAll(".swatch").forEach(s => s.classList.remove("selected"));
    sw.classList.add("selected");
    state.color    = sw.dataset.color;
    state.colorAdd = parseInt(sw.dataset.add);
    updateSummary();
  });
});

// ── Engine radio buttons ────────────────────────────────────
document.querySelectorAll(".engine-option").forEach(opt => {
  opt.addEventListener("click", () => {
    document.querySelectorAll(".engine-option").forEach(o => o.classList.remove("selected"));
    opt.classList.add("selected");
    const radio      = opt.querySelector("input[type='radio']");
    radio.checked    = true;
    state.engine     = radio.value;
    state.engineAdd  = parseInt(radio.dataset.add);
    updateSummary();
  });
});

// ── Accessories checkboxes ─────────────────────────────────
document.querySelectorAll(".acc-item input[type='checkbox']").forEach(cb => {
  cb.addEventListener("change", () => {
    const item = cb.closest(".acc-item");
    const name = cb.dataset.acc;
    if (cb.checked) {
      item.classList.add("selected");
      if (!state.accessories.includes(name)) state.accessories.push(name);
    } else {
      item.classList.remove("selected");
      state.accessories = state.accessories.filter(a => a !== name);
    }
    updateSummary();
  });
});

// ── SAVE to localStorage ───────────────────────────────────
document.getElementById("btnSave").addEventListener("click", () => {
  if (!state.model) {
    showToast("⚠️ Please choose a model first!");
    return;
  }
  const accTotal = state.accessories.reduce((sum, name) => {
    const el = document.querySelector(`[data-acc="${name}"]`);
    return sum + (el ? parseInt(el.dataset.add) : 0);
  }, 0);
  const total = state.basePrice + state.colorAdd + state.engineAdd + accTotal;

  const build = {
    model:       state.model,
    basePrice:   state.basePrice,
    color:       state.color,
    colorAdd:    state.colorAdd,
    engine:      state.engine,
    engineAdd:   state.engineAdd,
    accessories: state.accessories,
    total:       total,
    savedAt:     new Date().toLocaleString()
  };

  localStorage.setItem("jeepBuild", JSON.stringify(build));
  updateStorageStatus();
  showToast("✅ Build saved to localStorage!");
});

// ── LOAD from localStorage ─────────────────────────────────
document.getElementById("btnLoad").addEventListener("click", () => {
  const raw = localStorage.getItem("jeepBuild");
  if (!raw) {
    showToast("⚠️ No saved build found!");
    return;
  }
  const b = JSON.parse(raw);

  // Restore state
  state.model       = b.model;
  state.basePrice   = b.basePrice;
  state.color       = b.color;
  state.colorAdd    = b.colorAdd;
  state.engine      = b.engine;
  state.engineAdd   = b.engineAdd;
  state.accessories = b.accessories || [];

  // Restore model card
  document.querySelectorAll(".model-card").forEach(c => {
    c.classList.toggle("selected", c.dataset.model === b.model);
  });

  // Restore color swatch
  document.querySelectorAll(".swatch").forEach(s => {
    s.classList.toggle("selected", s.dataset.color === b.color);
  });

  // Restore engine
  document.querySelectorAll(".engine-option").forEach(opt => {
    const radio = opt.querySelector("input[type='radio']");
    const match = radio.value === b.engine;
    opt.classList.toggle("selected", match);
    radio.checked = match;
  });

  // Restore accessories
  document.querySelectorAll(".acc-item input[type='checkbox']").forEach(cb => {
    const checked = b.accessories.includes(cb.dataset.acc);
    cb.checked = checked;
    cb.closest(".acc-item").classList.toggle("selected", checked);
  });

  updateSummary();
  showToast(`📂 Loaded: ${b.model} build from ${b.savedAt}`);
});

// ── CLEAR localStorage ─────────────────────────────────────
document.getElementById("btnClear").addEventListener("click", () => {
  localStorage.removeItem("jeepBuild");
  updateStorageStatus();
  showToast("🗑 Saved build cleared.");
});

// ── Init ───────────────────────────────────────────────────
updateStorageStatus();
updateSessionTracker();
updateSummary();
</script>

<script src="JavaScript.js"></script>
</body>
